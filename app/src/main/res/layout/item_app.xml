<?xml version="1.0" encoding="utf-8"?>
<!-- 앱 한 줄. 줄 전체를 누르면 체크가 바뀐다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:descendantFocusability="blocksDescendants"
    android:gravity="center_vertical"
    android:minHeight="@dimen/row_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/gutter"
    android:paddingTop="@dimen/gap_small"
    android:paddingEnd="@dimen/gutter"
    android:paddingBottom="@dimen/gap_small">

    <ImageView
        android:id="@+id/img_icon"
        android:layout_width="@dimen/icon_app"
        android:layout_height="@dimen/icon_app"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/tv_app_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap"
        android:layout_marginEnd="@dimen/gap"
        android:layout_weight="1"
        android:textAppearance="@style/Text.Harulock.Body" />

    <CheckBox
        android:id="@+id/cb_allowed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false" />
</LinearLayout>
