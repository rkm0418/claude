<?xml version="1.0" encoding="utf-8"?>
<!-- 비상 해제. 화면 동작은 Task 12의 ReleaseActivity가 맡는다. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/gutter">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/release_title"
            android:textAppearance="@style/Text.Harulock.Title" />

        <TextView
            android:id="@+id/tv_release_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:text="@string/release_desc"
            android:textAppearance="@style/Text.Harulock.Body" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:id="@+id/tv_release_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Text.Harulock.Heading" />

            <TextView
                android:id="@+id/tv_release_remaining"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_small"
                android:textAppearance="@style/Text.Harulock.Body" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_request"
            style="@style/Widget.Harulock.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_large"
            android:text="@string/action_release_request" />

        <Button
            android:id="@+id/btn_cancel_request"
            style="@style/Widget.Harulock.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap"
            android:text="@string/action_release_cancel" />

        <Button
            android:id="@+id/btn_confirm"
            style="@style/Widget.Harulock.Button.Lock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap"
            android:text="@string/action_release_confirm" />
    </LinearLayout>
</ScrollView>
