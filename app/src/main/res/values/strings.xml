    <string name="instant_title">즉시 잠금</string>
    <string name="instant_30m">30분</string>
    <string name="instant_1h">1시간</string>
    <string name="instant_2h">2시간</string>
    <string name="instant_hint">직접 입력(1~1440분)</string>
