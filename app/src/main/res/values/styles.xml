<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 밝은/어두운 바탕 테마. values-night/styles.xml이 어두운 쪽으로 바꾼다. -->
    <style name="Harulock.Platform" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Harulock.DialogPlatform" parent="android:Theme.Material.Light.Dialog.Alert" />

    <style name="Theme.Harulock" parent="Harulock.Platform">
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:alertDialogTheme">@style/Harulock.Dialog</item>
        <item name="android:dialogTheme">@style/Harulock.Dialog</item>
    </style>

    <style name="Harulock.Dialog" parent="Harulock.DialogPlatform">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
    </style>

    <!-- 일반 버튼 -->
    <style name="Widget.Harulock.Button" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/button_text_state</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:paddingStart">@dimen/gutter</item>
        <item name="android:paddingEnd">@dimen/gutter</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 잠금을 시작하거나 되돌리기 어려운 동작의 버튼. 일반 버튼과 색으로 구분한다. -->
    <style name="Widget.Harulock.Button.Lock">
        <item name="android:background">@drawable/bg_button_lock</item>
        <item name="android:textColor">@color/button_lock_text_state</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Harulock.Title" parent="android:TextAppearance.Material">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Harulock.Heading" parent="android:TextAppearance.Material">
        <item name="android:textSize">@dimen/text_heading</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Harulock.Body" parent="android:TextAppearance.Material">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Harulock.Small" parent="android:TextAppearance.Material">
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>
